{
	"name": "triple-triad-solver",
	"version": "0.0.3",
	"description": "A web app, which employs a minimax strategy to solve Final Fantasy VIII's Triple Triad minigame.",
	"keywords": [
		"FFVIII",
		"Final Fantasy VIII",
		"Triple Triad",
		"minimax",
		"solver"
	],
	"homepage": "https://github.com/PhilipArmstead/Triple-Triad-Solver#readme",
	"bugs": {
		"url": "https://github.com/PhilipArmstead/Triple-Triad-Solver/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "Phil Armstead <philarmstead@mailbox.org>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PhilipArmstead/Triple-Triad-Solver.git"
	},
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "oxlint && oxfmt --check",
		"lint:fix": "oxlint --fix-suggestions && oxfmt",
		"test": "vitest --run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-sort-class-members": "^1.22.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.66.0",
		"sass-embedded": "^1.104.1",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
}
